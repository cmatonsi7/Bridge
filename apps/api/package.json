{
  "name": "@sportbridge/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "grant-admin": "tsx --env-file=../../.env src/scripts/grantAdmin.ts"
  },
  "dependencies": {
    "@sportbridge/shared": "0.1.0",
    "express": "4.21.2",
    "express-rate-limit": "7.4.1",
    "firebase-admin": "12.7.0",
    "helmet": "8.0.0",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/node": "22.9.0",
    "@types/supertest": "6.0.2",
    "supertest": "7.0.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
