# Copy to .env for local development. Never commit .env.
# In Railway, set the same names under the service's Variables tab.

# --- Web (public by design; protected by Firebase rules, not secrecy) ---
# Firebase console → Project settings → General → Your apps → Web app → SDK setup and configuration → Config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# true = use local Firebase emulators instead of the real project
VITE_USE_FIREBASE_EMULATORS=false

# --- API (server only; SECRET) ---
# Base64 of the service-account JSON: Firebase console → Project settings → Service accounts → Generate new private key
#   macOS/Linux:  base64 -i key.json | tr -d '\n'
#   Windows PowerShell:  [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
FIREBASE_SERVICE_ACCOUNT_BASE64=
FIREBASE_PROJECT_ID=
PORT=8080
NODE_ENV=development
TRUST_PROXY_HOPS=1


//Firebase webapp keys

