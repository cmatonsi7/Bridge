// For Firebase JS SDK v7.20.0 and later, measurementId is optional
const firebaseConfig = {
  apiKey: "AIzaSyDNQMsnpOoCptd_cc_KST1yC1nadtvxiEY",
  authDomain: "sportbridge-4861e.firebaseapp.com",
  projectId: "sportbridge-4861e",
  storageBucket: "sportbridge-4861e.firebasestorage.app",
  messagingSenderId: "986808954201",
  appId: "1:986808954201:web:713e8dd94a4bfdf16db048",
  measurementId: "G-V2DGY9XKNN"
};

// Initialize Firebase
const app = initializeApp(firebaseConfig);
const analytics = getAnalytics(app);