rules_version = '2';

// SportBridge Firestore rules — Phase 1 (foundation and authentication).
// Principle: deny by default. Roles, account status, minor status, memberships and links are written
// only by the backend (Admin SDK bypasses these rules). Clients may edit a small set of their own fields.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function userDoc(uid) { return get(/databases/$(database)/documents/users/$(uid)).data; }
    function isShortString(v, max) { return v is string && v.size() > 0 && v.size() <= max; }
    // A verified parent/guardian of this athlete (server adds them when they confirm a request).
    function isGuardianOf(uid) {
      return signedIn() && request.auth.uid in userDoc(uid).get('guardianUids', []);
    }

    // ---- users/{uid}: owner and admins can read; owner may only edit their name ----
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin() || isGuardianOf(uid);
      allow create, delete: if false; // created by POST /api/onboarding
      allow update: if isSelf(uid)
        && changed().hasOnly(['firstName', 'surname', 'displayName', 'updatedAt'])
        && isShortString(request.resource.data.firstName, 60)
        && isShortString(request.resource.data.surname, 60)
        && isShortString(request.resource.data.displayName, 121);

      // In-app notifications (Phase 3b): written by the server; the owner may mark them read or delete them.
      match /notifications/{notificationId} {
        allow read, delete: if isSelf(uid);
        allow create: if false;
        allow update: if isSelf(uid) && changed().hasOnly(['read']) && request.resource.data.read is bool;
      }

      // A member's shortlist of saved listings (Phase 3a).
      match /saved/{listingId} {
        allow read, delete: if isSelf(uid);
        allow create: if isSelf(uid)
          && request.resource.data.keys().hasOnly(['listingId', 'kind', 'title', 'savedAt'])
          && request.resource.data.listingId == listingId
          && request.resource.data.kind in ['opportunity', 'programme']
          && isShortString(request.resource.data.title, 120)
          && request.resource.data.savedAt is string;
        allow update: if false;
      }

      // Date of birth and mobile. Never public. Changing DOB would change minor status, so it is server-only.
      match /private/{docId} {
        allow read: if isSelf(uid) || isAdmin();
        allow create, delete: if false;
        // The owner may change their mobile number (Settings). DOB stays server-only, since it decides minor status.
        allow update: if isSelf(uid)
          && changed().hasOnly(['mobile'])
          && request.resource.data.mobile is string
          && request.resource.data.mobile.matches('^\\+?[0-9]{9,15}$');
      }
    }

    // ---- Role profiles. Phase 2 extends read access according to each profile's visibility. ----
    function profileUpdateAllowed(uid) {
      return isSelf(uid)
        && !changed().hasAny(['uid', 'createdAt'])
        // A minor cannot make their own profile more visible; a verified guardian does that (Phase 2).
        && (!changed().hasAny(['visibility']) || userDoc(uid).isMinor == false)
        && (!('visibility' in request.resource.data) || request.resource.data.visibility in ['private', 'members', 'public']);
    }

    // ---- Athlete profiles (Phase 2a). Lists must match packages/shared/src/athlete.ts exactly. ----
    function sports() {
      return ['Football', 'Rugby', 'Cricket', 'Netball', 'Athletics', 'Swimming', 'Hockey', 'Basketball',
              'Tennis', 'Golf', 'Boxing', 'Volleyball', 'Gymnastics', 'Cycling', 'Rowing', 'Squash'];
    }
    function skills() {
      return ['Teamwork', 'Leadership', 'Discipline', 'Communication', 'Technical Ability',
              'Game Intelligence', 'Fitness & Conditioning', 'Coachability', 'Resilience', 'Time Management'];
    }
    function interests() {
      return sports().concat(['Strength & Conditioning', 'Sports Science', 'Coaching', 'Sports Media', 'Event Management']);
    }
    function provinces() {
      return ['Eastern Cape', 'Free State', 'Gauteng', 'KwaZulu-Natal', 'Limpopo', 'Mpumalanga',
              'Northern Cape', 'North West', 'Western Cape'];
    }
    function optText(d, k, max) { return !(k in d) || d[k] == null || (d[k] is string && d[k].size() <= max); }
    function validAthleteProfile(d) {
      return (!('sport' in d) || d.sport == null || d.sport in sports())
        && (!('province' in d) || d.province == null || d.province in provinces())
        && optText(d, 'position', 40) && optText(d, 'city', 60) && optText(d, 'club', 80)
        && optText(d, 'school', 80) && optText(d, 'bio', 600)
        && (!('experienceYears' in d) || d.experienceYears == null
            || (d.experienceYears is int && d.experienceYears >= 0 && d.experienceYears <= 40))
        && (!('skills' in d) || (d.skills is list && d.skills.size() <= 10 && d.skills.hasOnly(skills())))
        && (!('interests' in d) || (d.interests is list && d.interests.size() <= 12 && d.interests.hasOnly(interests())))
        && (!('privacy' in d) || (d.privacy is map
            && d.privacy.keys().hasOnly(['discoverable', 'showAchievements', 'allowEnquiries'])
            && d.privacy.discoverable is bool && d.privacy.showAchievements is bool && d.privacy.allowEnquiries is bool))
        && d.updatedAt is string;
    }

    match /athleteProfiles/{uid} {
      allow read: if isSelf(uid) || isAdmin() || isGuardianOf(uid);
      allow create, delete: if false;
      allow update: if profileUpdateAllowed(uid)
        && changed().hasOnly(['sport', 'position', 'city', 'province', 'club', 'school', 'experienceYears',
                              'bio', 'skills', 'interests', 'privacy', 'visibility', 'displayName', 'updatedAt'])
        && validAthleteProfile(request.resource.data);

      // Achievements: the athlete manages their own list.
      match /achievements/{achievementId} {
        function validAchievement(d) {
          return d.keys().hasOnly(['title', 'year', 'organisation', 'detail', 'createdAt', 'updatedAt'])
            && d.title is string && d.title.size() >= 2 && d.title.size() <= 100
            && d.year is int && d.year >= 1950 && d.year <= 2100
            && optText(d, 'organisation', 80) && optText(d, 'detail', 200)
            && d.createdAt is string && d.updatedAt is string;
        }
        allow read: if isSelf(uid) || isAdmin() || isGuardianOf(uid);
        allow create: if isSelf(uid) && validAchievement(request.resource.data);
        allow update: if isSelf(uid) && validAchievement(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isSelf(uid);
      }
    }
    // ---- Coach profiles (Phase 2c). Lists must match packages/shared/src/coach.ts exactly. ----
    function coachingLevels() { return ['Community', 'School', 'Club', 'Academy', 'Provincial', 'National', 'Professional']; }
    function coachSpecialisations() {
      return ['Technical Skills', 'Tactical Development', 'Strength & Conditioning', 'Speed & Agility',
              'Goalkeeping', 'Mental Performance', 'Injury Prevention', 'Youth Development', 'Talent Identification'];
    }
    function coachServices() {
      return ['One-on-One Coaching', 'Group Sessions', 'Team Coaching', 'Holiday Camps', 'Online Coaching', 'Trials Preparation'];
    }
    function ageGroups() { return ['Under 10', 'Under 13', 'Under 16', 'Under 19', 'Adults']; }
    function validCoachProfile(d) {
      return (!('sports' in d) || (d.sports is list && d.sports.size() <= 5 && d.sports.hasOnly(sports())))
        && (!('coachingLevel' in d) || d.coachingLevel == null || d.coachingLevel in coachingLevels())
        && (!('province' in d) || d.province == null || d.province in provinces())
        && (!('experienceYears' in d) || d.experienceYears == null
            || (d.experienceYears is int && d.experienceYears >= 0 && d.experienceYears <= 60))
        && optText(d, 'organisation', 80) && optText(d, 'city', 60) && optText(d, 'bio', 800)
        && (!('specialisations' in d) || (d.specialisations is list && d.specialisations.hasOnly(coachSpecialisations())))
        && (!('services' in d) || (d.services is list && d.services.hasOnly(coachServices())))
        && (!('ageGroups' in d) || (d.ageGroups is list && d.ageGroups.hasOnly(ageGroups())))
        && (!('privacy' in d) || (d.privacy is map
            && d.privacy.keys().hasOnly(['discoverable', 'showQualifications', 'allowEnquiries'])
            && d.privacy.discoverable is bool && d.privacy.showQualifications is bool && d.privacy.allowEnquiries is bool))
        && d.updatedAt is string;
    }

    match /coachProfiles/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, delete: if false;
      allow update: if profileUpdateAllowed(uid)
        && changed().hasOnly(['sports', 'coachingLevel', 'experienceYears', 'organisation', 'city', 'province', 'bio',
                              'specialisations', 'services', 'ageGroups', 'privacy', 'visibility', 'displayName', 'updatedAt'])
        && validCoachProfile(request.resource.data);

      // Self-declared qualifications. Verification fields will be server-written (Phase 5).
      match /qualifications/{qualificationId} {
        function validQualification(d) {
          return d.keys().hasOnly(['title', 'issuer', 'year', 'createdAt', 'updatedAt'])
            && d.title is string && d.title.size() >= 2 && d.title.size() <= 100
            && optText(d, 'issuer', 80)
            && (!('year' in d) || d.year == null || (d.year is int && d.year >= 1950 && d.year <= 2100))
            && d.createdAt is string && d.updatedAt is string;
        }
        allow read: if isSelf(uid) || isAdmin();
        allow create: if isSelf(uid) && validQualification(request.resource.data);
        allow update: if isSelf(uid) && validQualification(request.resource.data)
          && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if isSelf(uid);
      }
    }
    match /guardianProfiles/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create, delete: if false;
      allow update: if profileUpdateAllowed(uid);
    }

    // ---- Organisations: one owner in the MVP. Ownership and verification are server-controlled. ----
    // ---- Organisations (Phase 2d). Lists must match packages/shared (roles.ts, organisation.ts, coach.ts). ----
    function organisationTypes() {
      return ['club', 'school', 'academy', 'sports_facility', 'programme_provider', 'tertiary',
              'service_provider', 'federation', 'other'];
    }
    function orgOfferings() {
      return ['Teams & Leagues', 'Academy Programmes', 'Holiday Camps', 'Trials', 'Coaching Clinics',
              'Scholarships & Bursaries', 'Sports Science', 'Facility Hire'];
    }
    function orgFacilities() {
      return ['Grass Field', 'Artificial Turf', 'Indoor Hall', 'Swimming Pool', 'Athletics Track', 'Gym', 'Courts', 'Changing Rooms'];
    }
    function validOrganisation(d) {
      return isShortString(d.name, 120) && d.type in organisationTypes()
        && optText(d, 'description', 1000) && optText(d, 'city', 60)
        && (!('contactEmail' in d) || d.contactEmail == null
            || (d.contactEmail is string && d.contactEmail.size() <= 120 && d.contactEmail.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')))
        && (!('contactPhone' in d) || d.contactPhone == null
            || (d.contactPhone is string && d.contactPhone.matches('^\\+?[0-9]{9,15}$')))
        && (!('website' in d) || d.website == null
            || (d.website is string && d.website.size() <= 200 && d.website.matches('^https?://.+')))
        && (!('province' in d) || d.province == null || d.province in provinces())
        && (!('sports' in d) || (d.sports is list && d.sports.size() <= 10 && d.sports.hasOnly(sports())))
        && (!('ageGroups' in d) || (d.ageGroups is list && d.ageGroups.hasOnly(ageGroups())))
        && (!('offerings' in d) || (d.offerings is list && d.offerings.hasOnly(orgOfferings())))
        && (!('facilities' in d) || (d.facilities is list && d.facilities.hasOnly(orgFacilities())))
        && (!('privacy' in d) || (d.privacy is map
            && d.privacy.keys().hasOnly(['listed', 'showContactDetails', 'acceptEnquiries'])
            && d.privacy.listed is bool && d.privacy.showContactDetails is bool && d.privacy.acceptEnquiries is bool))
        && d.updatedAt is string;
    }

    match /organisations/{orgId} {
      allow read: if isAdmin() || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create, delete: if false;
      // ownerUid, verified and createdAt are server-only (verification comes with the admin dashboard).
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && changed().hasOnly(['name', 'type', 'description', 'contactEmail', 'contactPhone', 'website', 'city',
                              'province', 'sports', 'ageGroups', 'offerings', 'facilities', 'privacy', 'updatedAt'])
        && validOrganisation(request.resource.data);
    }

    // ---- Listings: opportunities and programmes (Phase 3a). Lists must match packages/shared/src/listings.ts. ----
    function listingTypes() { return ['Trial', 'Scholarship', 'Bursary', 'Programme', 'Talent ID', 'High Performance', 'Event']; }
    function listingInclusions() { return ['Meals', 'Equipment', 'Transport', 'Accommodation', 'Kit', 'Certificate']; }
    function isoDate(v) { return v is string && v.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'); }
    function optIsoDate(d, k) { return !(k in d) || d[k] == null || isoDate(d[k]); }
    function orgDoc(orgId) { return get(/databases/$(database)/documents/organisations/$(orgId)).data; }
    function validListing(d) {
      return d.keys().hasOnly(['kind', 'type', 'title', 'description', 'sports', 'province', 'city', 'ageMin', 'ageMax',
                               'deadline', 'startDate', 'endDate', 'isFree', 'priceZar', 'inclusions', 'status',
                               'orgId', 'ownerUid', 'orgName', 'orgVerified', 'createdAt', 'updatedAt', 'publishedAt'])
        && d.kind in ['opportunity', 'programme'] && d.type in listingTypes()
        && isShortString(d.title, 120) && d.title.size() >= 3
        && d.description is string && d.description.size() >= 20 && d.description.size() <= 3000
        && d.sports is list && d.sports.size() >= 1 && d.sports.size() <= 5 && d.sports.hasOnly(sports())
        && d.province in provinces() && isShortString(d.city, 60)
        && d.ageMin is int && d.ageMax is int && d.ageMin >= 5 && d.ageMax <= 99 && d.ageMin <= d.ageMax
        && isoDate(d.deadline) && optIsoDate(d, 'startDate') && optIsoDate(d, 'endDate')
        && d.isFree is bool
        && (d.isFree ? d.priceZar == null : (d.priceZar is int && d.priceZar >= 1 && d.priceZar <= 1000000))
        && d.inclusions is list && d.inclusions.hasOnly(listingInclusions())
        && d.status in ['draft', 'published', 'closed']
        && d.createdAt is string && d.updatedAt is string;
    }
    // The organisation's name and verified flag on a listing must match the organisation record,
    // so a listing can never claim a verified badge the organisation does not have.
    function ownsOrgListing(d) {
      return signedIn() && request.auth.token.role == 'organisation'
        && d.ownerUid == request.auth.uid
        && userDoc(request.auth.uid).get('organisationId', '') == d.orgId
        && orgDoc(d.orgId).ownerUid == request.auth.uid
        && d.orgName == orgDoc(d.orgId).name
        && d.orgVerified == orgDoc(d.orgId).verified;
    }

    match /listings/{listingId} {
      // Published listings are public (the public site shows them); drafts only to their organisation.
      allow read: if resource.data.status == 'published'
        || isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow create: if ownsOrgListing(request.resource.data) && validListing(request.resource.data)
        && request.resource.data.status in ['draft', 'published'];
      allow update: if ownsOrgListing(request.resource.data) && validListing(request.resource.data)
        && resource.data.ownerUid == request.auth.uid
        && !changed().hasAny(['orgId', 'ownerUid', 'createdAt']);
      // Only drafts can be deleted; published listings are closed instead, so applicants keep a record.
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid && resource.data.status == 'draft';
    }

    // ---- Applications (Phase 3b). Created and changed only by the server, which applies the safeguarding checks.
    match /applications/{applicationId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.applicantUid == request.auth.uid)
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isGuardianOf(resource.data.applicantUid);
      allow write: if false;
    }

    // ---- Guardian links: visible to the athlete it concerns, the linked guardian, and admins. Server-written. ----
    match /guardianLinks/{linkId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.athleteUid == request.auth.uid)
        || (signedIn() && resource.data.guardianUid == request.auth.uid)
        // A parent sees requests addressed to their own verified email (match-on-sign-up).
        || (signedIn() && request.auth.token.email_verified == true
            && request.auth.token.email != null
            && resource.data.guardianEmail == request.auth.token.email.lower());
      allow write: if false;
    }

    // ---- Audit log: append-only from the server, readable by admins. ----
    match /auditLogs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Everything else is denied until its phase defines rules.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
